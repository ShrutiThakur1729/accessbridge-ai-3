PORT=3000
NODE_ENV=development
INTENT_SAFETY_URL=http://localhost:8000/api/v1
VISION_PERCEPTION_URL=http://localhost:8010/api/v1
# Whisper-compatible endpoint accepting multipart `file` and returning `{ "text": "..." }`.
STT_URL=http://localhost:9000/v1/audio/transcriptions
STT_MODEL=whisper-1
MIN_AUDIO_BYTES=256
MAX_AUDIO_BYTES=26214400
