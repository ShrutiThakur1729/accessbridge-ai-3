PORT=3000
NODE_ENV=development
INTENT_SAFETY_URL=http://localhost:8000/api/v1
VISION_PERCEPTION_URL=http://localhost:8010/api/v1
# Whisper-compatible endpoint accepting multipart `file` and returning `{ "text": "..." }`.
STT_URL=http://localhost:9000/v1/audio/transcriptions
STT_MODEL=whisper-1
MIN_AUDIO_BYTES=256
MAX_AUDIO_BYTES=26214400

# ── Databricks SQL Statement API (Telemetry Pipeline) ──
DATABRICKS_HOST=adb-xxxxxxxxxxxx.x.azuredatabricks.net
DATABRICKS_TOKEN=dapi_your_personal_access_token_here
DATABRICKS_HTTP_PATH=your_sql_warehouse_id

# ── Telemetry WebSocket Port (default: 3001) ──
TELEMETRY_WS_PORT=3001
